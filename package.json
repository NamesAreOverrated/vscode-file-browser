{
    "name": "file-browser-plus",
    "publisher": "NamesAreOverrated",
    "displayName": "File Browser",
    "description": "A nicer alternative to the file open dialog.",
    "version": "1.1.0",
    "license": "LGPL-3.0+",
    "author": {
        "name": "NamesAreOverrated"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/NamesAreOverrated/vscode-file-browser"
    },
    "keywords": [
        "emacs",
        "helm"
    ],
    "icon": "images/icon.png",
    "engines": {
        "vscode": "^1.110.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/extension.js",
    "extensionKind": [
        "workspace",
        "ui"
    ],
    "contributes": {
        "configuration": {
            "title": "File Browser",
            "properties": {
                "file-browser.explorer.excludeHidden": {
                    "type": "boolean",
                    "default": false,
                    "description": "[List View] Hide dot-files (e.g. .git, .env) from the file browser list. Default is false (show everything)."
                },
                "file-browser.explorer.excludeGitIgnore": {
                    "type": "boolean",
                    "default": false,
                    "description": "[List View] Hide files ignored by .gitignore in the file browser list. Default is false (show everything so you can manage them)."
                },
                "file-browser.explorer.excludeVSCodeFiles": {
                    "type": "boolean",
                    "default": false,
                    "description": "[List View] Hide files defined in VS Code's 'files.exclude' from the file browser list. Default is false."
                },
                "file-browser.search.respectVSCodeExcludes": {
                    "type": "boolean",
                    "default": true,
                    "description": "[Search] Exclude files matching VS Code's 'files.exclude' and 'search.exclude' when doing global/text searches (## , ! , etc)."
                },
                "file-browser.search.excludePatterns": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/node_modules/**",
                        "**/.git/**",
                        "**/dist/**",
                        "**/build/**",
                        "**/.next/**",
                        "**/.cache/**",
                        "**/.vscode/**",
                        "**/*.map",
                        "**/*.min.js",
                        "**/*.min.css",
                        "**/package-lock.json",
                        "**/yarn.lock",
                        "**/pnpm-lock.yaml",
                        "**/*.lock",
                        "**/*.log",
                        "**/*.png",
                        "**/*.jpg",
                        "**/*.jpeg",
                        "**/*.gif",
                        "**/*.svg",
                        "**/*.ico",
                        "**/*.mp3",
                        "**/*.mp4",
                        "**/*.pdf",
                        "**/*.exe",
                        "**/*.dll"
                    ],
                    "description": "[Search] Heavy glob patterns to always exclude during global text/file searches to prevent lag."
                },
                "file-browser.previewIgnoreExtensions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        ".png",
                        ".jpg",
                        ".jpeg",
                        ".gif",
                        ".svg",
                        ".ico",
                        ".webp",
                        ".bmp",
                        ".mp4",
                        ".mp3",
                        ".wav",
                        ".ogg",
                        ".mkv",
                        ".avi",
                        ".webm",
                        ".zip",
                        ".tar",
                        ".gz",
                        ".rar",
                        ".7z",
                        ".tgz",
                        ".pdf",
                        ".doc",
                        ".docx",
                        ".xls",
                        ".xlsx",
                        ".ppt",
                        ".pptx",
                        ".exe",
                        ".dll",
                        ".so",
                        ".dylib",
                        ".bin",
                        ".class",
                        ".pyc",
                        ".ttf",
                        ".woff",
                        ".woff2",
                        ".eot"
                    ],
                    "description": "File extensions that should NOT be previewed when navigating the list."
                }
            }
        },
        "commands": [
            {
                "command": "file-browser.open",
                "title": "File Browser: Open"
            },
            {
                "command": "file-browser.rename",
                "title": "File Browser: Rename"
            },
            {
                "command": "file-browser.stepIn",
                "title": "File Browser: Step In"
            },
            {
                "command": "file-browser.stepOut",
                "title": "File Browser: Step Out"
            },
            {
                "command": "file-browser.actions",
                "title": "File Browser: Actions"
            }
        ],
        "keybindings": [
            {
                "key": "right",
                "command": "file-browser.stepIn",
                "when": "inFileBrowser"
            },
            {
                "key": "left",
                "command": "file-browser.stepOut",
                "when": "inFileBrowser"
            },
            {
                "key": "ctrl+a",
                "command": "file-browser.actions",
                "when": "inFileBrowser"
            },
            {
                "key": "tab",
                "command": "file-browser.tabNext",
                "when": "inFileBrowser"
            },
            {
                "key": "shift+tab",
                "command": "file-browser.tabPrev",
                "when": "inFileBrowser"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "lint": "eslint src",
        "watch": "tsc -watch -p ./",
        "check": "npm run compile && npm run lint"
    },
    "devDependencies": {
        "@eslint/js": "^9.11.1",
        "@types/eslint__js": "^8.42.3",
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.8",
        "@types/node": "^22.19.17",
        "@types/vscode": "^1.110.0",
        "@typescript-eslint/eslint-plugin": "^8.8.0",
        "@typescript-eslint/parser": "^8.8.0",
        "@vscode/test-electron": "^2.4.1",
        "eslint": "^9.11.1",
        "glob": "^11.0.0",
        "mocha": "^10.7.3",
        "typescript": "^5.6.2",
        "typescript-eslint": "^8.8.0"
    },
    "dependencies": {
        "@bodil/opt": "^0.2.5",
        "ignore": "^6.0.2"
    }
}